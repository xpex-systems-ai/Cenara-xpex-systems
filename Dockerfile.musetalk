FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MUSETALK_ROOT=/opt/MuseTalk \
    FFMPEG_PATH=/usr/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ffmpeg python3.10 python3.10-dev python3-pip build-essential wget ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/local/bin/python

RUN git clone --depth 1 https://github.com/TMElyralab/MuseTalk.git /opt/MuseTalk

WORKDIR /opt/MuseTalk
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install torch==2.0.1 torchvision==0.15.2 torchaudio==2.0.2 --index-url https://download.pytorch.org/whl/cu118 && \
    pip install -r requirements.txt && \
    pip install --no-cache-dir -U openmim fastapi uvicorn python-multipart pyyaml && \
    mim install mmengine && \
    mim install "mmcv==2.0.1" && \
    mim install "mmdet==3.1.0" && \
    mim install "mmpose==1.1.0"

RUN bash ./download_weights.sh

COPY workers/musetalk_server.py /opt/worker/musetalk_server.py
ENV PYTHONPATH=/opt/worker:/opt/MuseTalk
EXPOSE 8000

CMD ["uvicorn", "musetalk_server:app", "--app-dir", "/opt/worker", "--host", "0.0.0.0", "--port", "8000"]
